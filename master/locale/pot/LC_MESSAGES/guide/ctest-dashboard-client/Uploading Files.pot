msgid "``logs.tar.gz``"
msgstr ""

#: ../../../guide/ctest-dashboard-client/Uploading Files.rst:18
msgid ""
"An archive of the logs that CTest wrote during this run, created "
"with :command:`file(ARCHIVE_CREATE)`."
msgstr ""

#: ../../../guide/ctest-dashboard-client/Uploading Files.rst:21
msgid "``cmake.url``"
msgstr ""

#: ../../../guide/ctest-dashboard-client/Uploading Files.rst:22
msgid "A file that contains only a URL.  CDash shows it as a link."
msgstr ""

