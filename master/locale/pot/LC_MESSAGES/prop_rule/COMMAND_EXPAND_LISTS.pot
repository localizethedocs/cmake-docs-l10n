#: ../../../prop_rule/COMMAND_EXPAND_LISTS.rst:2
msgid "COMMAND_EXPAND_LISTS"
msgstr ""

#: ../../../prop_rule/COMMAND_EXPAND_LISTS.rst:6
msgid ""
"``COMMAND_EXPAND_LISTS`` is a boolean specifying that the lists in the "
"``COMMAND`` arguments of the :command:`add_custom_rule` command will be "
"expanded, including those created with :manual:`generator expressions <cmake-"
"generator-expressions(7)>`."
msgstr ""

#: ../../../prop_rule/COMMAND_EXPAND_LISTS.rst:11
msgid "By default, ``COMMAND_EXPAND_LISTS`` is true."
msgstr ""
