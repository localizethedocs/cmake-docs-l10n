#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:2
msgid "OUTPUT_FILE_SET_BASE_DIRS"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:6
msgid "Specify the base directories for the output file set."
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:8
msgid ""
"The ``OUTPUT_FILE_SET_BASE_DIRS`` may be set to a :ref:`semicolon-separated "
"list <CMake Language Lists>` of directories."
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:11
msgid "The directories can use the following patterns:"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:13
msgid "``<RULE>``: name of the rule"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:14
msgid "``<TARGET>``: name of the target"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:15
msgid "``<FILE_SET>``: name of the file set"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:16
msgid ""
"``<CURRENT_SOURCE_DIR>``: path to the source directory of the file set "
"creation"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:18
msgid ""
"``<CURRENT_BINARY_DIR>``: path to the binary directory of the file set "
"creation"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:20
msgid ""
"``<OUTPUT_CURRENT_SOURCE_DIR>``: path to the source directory of the output "
"file set creation"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:22
msgid ""
"``<OUTPUT_CURRENT_BINARY_DIR>``: path to the binary directory of the output "
"file set creation"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:25
msgid ""
"This property gets the following default value: ``<CURRENT_BINARY_DIR>``."
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET_BASE_DIRS.rst:27
msgid ""
"Contents of ``OUTPUT_FILE_SET_BASE_DIRS`` may use generator expressions with "
"the syntax ``$<...>``. See the cmake-buildsystem(7) manual for more on "
"defining buildsystem properties."
msgstr ""
