#: ../../../prop_rule/DEPENDS_EXPLICIT_ONLY.rst:2
msgid "DEPENDS_EXPLICIT_ONLY"
msgstr ""

#: ../../../prop_rule/DEPENDS_EXPLICIT_ONLY.rst:6
msgid ""
"``DEPENDS_EXPLICIT_ONLY`` is a boolean indicating that the rule's "
"``DEPENDS`` argument represents all files required by the command and "
"implicit dependencies are not required."
msgstr ""

#: ../../../prop_rule/DEPENDS_EXPLICIT_ONLY.rst:10
msgid ""
"If not defined, the :variable:"
"`CMAKE_ADD_CUSTOM_COMMAND_DEPENDS_EXPLICIT_ONLY` will be used during the "
"instantiations of the rule."
msgstr ""
