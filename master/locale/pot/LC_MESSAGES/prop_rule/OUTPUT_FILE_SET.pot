#: ../../../prop_rule/OUTPUT_FILE_SET.rst:2
msgid "OUTPUT_FILE_SET"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:6
msgid ""
"Specify the name and the type of the file set storing the files produced by "
"the instantiation of a rule."
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:9
msgid ""
"The ``OUTPUT_FILE_SET`` property must hold a :ref:`semicolon-separated list "
"<CMake Language Lists>` of two elements specifying the name of the file set "
"and the type."
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:13
msgid ""
"The name can use the following patterns to enable the production of unique "
"names for the output file set:"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:16
msgid "``<RULE>``: name of the rule"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:17
msgid "``<TARGET>``: name of the target"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:18
msgid "``<FILE_SET>``: name of the file set"
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:20
msgid "The type must be one of the :ref:`predefined types <File Sets>`."
msgstr ""

#: ../../../prop_rule/OUTPUT_FILE_SET.rst:22
msgid ""
"This property gets the following default value: "
"``__cmake_rule_<RULE>_<TARGET>_<FILE_SET>_outputs;SOURCES``."
msgstr ""
