#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:2
msgid "CMAKE_LINK_WRAPPER_<NAME>"
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:6
msgid "Command line to be prepended to link commands."
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:8
msgid ""
"This property holds a command line to be used with the :prop_tgt:"
"`LINK_WRAPPERS` and/or :prop_tgt:`INTERFACE_LINK_WRAPPERS` target "
"properties. Named values in those properties (which are :ref:`semicolon-"
"separated lists <CMake Language Lists>`) will reference the correspondingly-"
"named ``CMAKE_LINK_WRAPPER_<NAME>`` and prepend the link command for the "
"output artifact of the given target or its consumer(s) with the value of "
"this property."
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:16
msgid ""
"This property is supported only by :ref:`Makefile Generators` and :ref:"
"`Ninja Generators`, and is ignored by other generators."
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:19
msgid ""
"The value is a :ref:`semicolon-separated list <CMake Language Lists>` of "
"command line arguments.  Empty arguments are preserved, and a literal "
"semicolon within an argument may be written as ``\\;``."
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:23
msgid ""
"Contents of ``CMAKE_LINK_WRAPPER_<NAME>`` may use \"generator expressions\" "
"with the syntax ``$<...>``.  See the :manual:`cmake-generator-"
"expressions(7)` manual for available expressions.  See the :manual:`cmake-"
"buildsystem(7)` manual for more on defining buildsystem properties."
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:29
msgid "Example"
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:31
msgid ""
"add_library(iface INTERFACE)\n"
"add_executable(main main.c)\n"
"target_link_libraries(main PRIVATE iface)\n"
"\n"
"set_property(GLOBAL\n"
"  PROPERTY CMAKE_LINK_WRAPPER_2_PYTHON_WRAPPER\n"
"    \"${Python_EXECUTABLE}\" my_wrapper.py\n"
")\n"
"set_property(GLOBAL\n"
"  PROPERTY CMAKE_LINK_WRAPPER_1_TIME\n"
"    \"${CMAKE_COMMAND}\" -E time\n"
")\n"
"\n"
"set_target_properties(iface PROPERTIES\n"
"  INTERFACE_LINK_WRAPPERS 1_TIME\n"
")\n"
"set_target_properties(main PROPERTIES\n"
"  LINK_WRAPPERS 2_PYTHON_WRAPPER\n"
")"
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:53
msgid "Here, the link command for ``main`` will look like:"
msgstr ""

#: ../../../prop_gbl/CMAKE_LINK_WRAPPER_NAME.rst:55
msgid "/path/to/cmake -E time /path/to/python my_wrapper.py ..."
msgstr ""

