#: ../../../prop_tgt/SKIP_INSTALL_RPATH.rst:2
msgid "SKIP_INSTALL_RPATH"
msgstr ""

#: ../../../prop_tgt/SKIP_INSTALL_RPATH.rst:6
msgid "Should rpaths be used for the install tree."
msgstr ""

#: ../../../prop_tgt/SKIP_INSTALL_RPATH.rst:8
msgid ""
"``SKIP_INSTALL_RPATH`` is a boolean property that when set to true then the "
"software is always installed without ``RPATH``, even if ``RPATH`` is enabled "
"when building.  This can be useful for example to allow running tests from "
"the build directory with ``RPATH`` enabled before the installation step."
msgstr ""

#: ../../../prop_tgt/SKIP_INSTALL_RPATH.rst:14
msgid "See also the :prop_tgt:`INSTALL_RPATH` target property."
msgstr ""

#: ../../../prop_tgt/SKIP_INSTALL_RPATH.rst:16
msgid ""
"This property is initialized by the value of the "
"variable :variable:`CMAKE_SKIP_INSTALL_RPATH` when policy :policy:`CMP0229` "
"is set to ``NEW``."
msgstr ""
