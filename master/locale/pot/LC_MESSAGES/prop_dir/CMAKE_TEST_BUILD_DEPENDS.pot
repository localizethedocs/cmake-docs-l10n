#: ../../../prop_dir/CMAKE_TEST_BUILD_DEPENDS.rst:2
msgid "CMAKE_TEST_BUILD_DEPENDS"
msgstr ""

#: ../../../prop_dir/CMAKE_TEST_BUILD_DEPENDS.rst:6
msgid "List of directory-scoped build time dependencies for tests."
msgstr ""

#: ../../../prop_dir/CMAKE_TEST_BUILD_DEPENDS.rst:8
msgid ""
"This property holds a :ref:`semicolon-separated list <CMake Language Lists>` "
"of targets and/or files that should be built by ``test_prep/all`` when :"
"variable:`CMAKE_TEST_BUILD_DEPENDS` is enabled."
msgstr ""

#: ../../../prop_dir/CMAKE_TEST_BUILD_DEPENDS.rst:13
msgid ""
"Projects may append to this property directly with :command:`set_property` "
"or :command:`set_directory_properties` to extend ``test_prep/all`` with "
"directory-scoped build dependencies."
msgstr ""
