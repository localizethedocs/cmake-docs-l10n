#: ../../../command/add_custom_rule.rst:161
msgid "``DEPENDS``"
msgstr ""

#: ../../../command/add_custom_rule.rst:162
msgid "Specify files on which the command depends."
msgstr ""

#: ../../../command/add_custom_rule.rst:164
msgid "``BYPRODUCTS``"
msgstr ""

#: ../../../command/add_custom_rule.rst:165
msgid ""
"Specify the files the command is expected to produce but whose modification "
"time may or may not be newer than the dependencies."
msgstr ""

#: ../../../command/add_custom_rule.rst:168
msgid "``DEPFILE``"
msgstr ""

#: ../../../command/add_custom_rule.rst:169
