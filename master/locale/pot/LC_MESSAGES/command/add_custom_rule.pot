#: ../../../command/add_custom_rule.rst:230
#: ../../../command/add_custom_rule.rst:356
msgid ""
"Make the rule name globally visible. Without this keyword, the rule will "
"only be visible in the directory where it was created as well as the sub-"
"directories."
msgstr ""

#: ../../../command/add_custom_rule.rst:235
#: ../../../command/add_custom_rule.rst:361
msgid "Example"
msgstr ""

#: ../../../command/add_custom_rule.rst:237
msgid "Define a rule to compile swig files:"
msgstr ""

#: ../../../command/add_custom_rule.rst:239
msgid ""
"function(fileset_configurator rule target fileset patterns)\n"
"  # define <OUTFILE_DIR> pattern\n"
"  set(${patterns} \"OUTFILE_DIR=<CURRENT_BINARY_DIR>\" PARENT_SCOPE)\n"
"endfunction()\n"
"\n"
"function(source_configurator rule target fileset source patterns)\n"
"  # define flag to handle C++\n"
"  get_property(cxx SOURCE \"${source}\" TARGET_DIRECTORY \"${target}\" "
"PROPERTY CPLUSPLUS)\n"
"  if (cxx)\n"
"    set_property(SOURCE \"${source}\" TARGET_DIRECTORY \"${target}\"\n"
"                 APPEND PROPERTY COMPILE_OPTIONS -c++)\n"
"  endif()\n"
"endfunction()\n"
"\n"
"set(OUTFILE_EXT \"$<IF:$<BOOL:$<SOURCE_PROPERTY:<SOURCE>,TARGET_DIRECTORY:"
"<TARGET>,CPLUSPLUS>>,.cxx,.c>\")\n"
"set(SWIG_LANGUAGE \"-$<STRING:TOLOWER,$<FILE_SET_PROPERTY:<FILE_SET>,TARGET:"
"<TARGET>,LANGUAGE>>\")\n"
"\n"
"add_custom_rule(swig\n"
"  OUTPUT \"<OUTFILE_DIR>/<BASE_NAME>${OUTFILE_EXT}\"\n"
"  COMMAND ${SWIG_EXECUTABLE} \"<SOURCE>\"\n"
"                             \"<OUTFILE_DIR>/<BASE_NAME>${OUTFILE_EXT}\"\n"
"                             ${SWIG_LANGUAGE}\n"
"                             <COMPILE_OPTIONS>\n"
"  CONFIGURATOR FOR_FILE_SET fileset_configurator FOR_SOURCE "
"source_configurator)"
msgstr ""

#: ../../../command/add_custom_rule.rst:266
msgid ""
"And, by defining a file set of type ``swig``, we can compile swig sources:"
msgstr ""

#: ../../../command/add_custom_rule.rst:268
msgid ""
"add_library(swig_example)\n"
"\n"
"target_sources(swig_example PRIVATE FILE_SET swig_srcs TYPE swig\n"
"                                    FILES file1.i file2.i)\n"
"# define the target language\n"
"set_property(FILE_SET swig_srcs TARGET swig_example PROPERTY LANGUAGE "
"python)\n"
"# define swig c++ mode\n"
"set_property(SOURCE file1.i file2.i PROPERTY CPLUSPLUS ON)"
msgstr ""

#: ../../../command/add_custom_rule.rst:280
msgid "Derived Rule"
msgstr ""

#: ../../../command/add_custom_rule.rst:288
msgid ""
"Create a new template rule ``<name>`` inheriting a snapshot of all the "
"characteristics of the ``<rule>``, including the properties except the "
"``GLOBAL`` one. Rule names defined in all uppercase are reserved for CMake's "
"own built-in rules."
msgstr ""

#: ../../../command/add_custom_rule.rst:293
msgid ""
"add_custom_rule(<name> FROM_RULE <rule>\n"
"                       [CONFIGURATOR [FOR_FILE_SET <configurator> [CHAIN|"
"OVERRIDE]]\n"
"                                     [FOR_SOURCE <configurator> [CHAIN|"
"OVERRIDE]]]\n"
"                       [GLOBAL])"
msgstr ""

#: ../../../command/add_custom_rule.rst:300
msgid ""
"Properties attached to this new rule can be freely customized, independently "
"of the rule we inherited from."
msgstr ""

#: ../../../command/add_custom_rule.rst:303
msgid "The options are:"
msgstr ""

#: ../../../command/add_custom_rule.rst:305
msgid "``FROM_RULE``"
msgstr ""

#: ../../../command/add_custom_rule.rst:306
msgid "Specify the rule from which this new rule will inherit."
msgstr ""

#: ../../../command/add_custom_rule.rst:309
msgid ""
"Specify one or two CMake functions which will be called at the generation "
"step before the effective instantiation and custom commands definition."
msgstr ""

#: ../../../command/add_custom_rule.rst:328
#: ../../../command/add_custom_rule.rst:341
msgid ""
"The ``patterns`` argument holds the name of the variable which can be used "
"to enrich the list of patterns."
msgstr ""

#: ../../../command/add_custom_rule.rst:344
msgid "For these two sub-options, there are two possible configurations:"
msgstr ""

#: ../../../command/add_custom_rule.rst:346
msgid "``CHAIN``"
msgstr ""

#: ../../../command/add_custom_rule.rst:347
msgid ""
"This ``<configurator>`` will be added to the already specified configurators "
"of inherited rules. Configurators will be called in order of their rules' "
"definition."
msgstr ""

#: ../../../command/add_custom_rule.rst:351
msgid "``OVERRIDE``"
msgstr ""

#: ../../../command/add_custom_rule.rst:352
msgid ""
"The specified ``<configurator>`` will override any other already defined "
"configurators. This is the default."
msgstr ""

#: ../../../command/add_custom_rule.rst:363
msgid ""
"By reusing the previous defined rule ``swig``, we can provide a more simple "
"way to compile swig sources by creating a more specialized rule:"
msgstr ""

#: ../../../command/add_custom_rule.rst:367
msgid ""
"function(python_configurator rule target fileset outputFileset patterns)\n"
"  # define target language\n"
"  set_property(FILE_SET ${fileset} TARGET ${target} PROPERTY LANGUAGE "
"python)\n"
"endfunction()\n"
"\n"
"function(cxx_configurator rule target fileset outputFileset source "
"patterns)\n"
"  # define swig c++ mode\n"
"  set_property(SOURCE \"${source}\" TARGET_DIRECTORY ${target} PROPERTY "
"CPLUSPLUS ON)\n"
"  set_property(SOURCE \"${source}\" TARGET_DIRECTORY ${target}\n"
"               APPEND PROPERTY COMPILE_OPTIONS -c++)\n"
"endfunction()\n"
"\n"
"add_custom_rule(swig_python FROM_RULE swig\n"
"                            CONFIGURATOR FOR_FILE_SET python_configurator "
"CHAIN\n"
"                                         FOR_SOURCE cxx_configurator "
"OVERRIDE)"
msgstr ""

#: ../../../command/add_custom_rule.rst:385
msgid ""
"Now, we can define a file set which does not need any specific settings. And "
"because the ``CHAIN`` option was specified for the file set configurator, "
"the pattern ``<OUTFILE_DIR>`` will be defined as well."
msgstr ""

#: ../../../command/add_custom_rule.rst:389
msgid ""
"add_library(swig_example)\n"
"\n"
"target_sources(swig_example PRIVATE FILE_SET swig_srcs TYPE swig_python\n"
"                                    FILES file1.i file2.i)"
msgstr ""

