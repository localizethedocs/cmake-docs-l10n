#: ../../../generator/FASTBuild.rst:2
msgid "FASTBuild"
msgstr ""

#: ../../../generator/FASTBuild.rst:6
msgid ""
"Generates a ``fbuild.bff`` file, which can be used to build the project with "
"`FASTBuild <https://www.fastbuild.org/docs/home.html>`_."
msgstr ""

#: ../../../generator/FASTBuild.rst:10
msgid "Usage"
msgstr ""

#: ../../../generator/FASTBuild.rst:12
msgid "Specify the generator when invoking :manual:`cmake(1)`:"
msgstr ""

#: ../../../generator/FASTBuild.rst:14
msgid "cmake [<options>] -G FASTBuild -B <path-to-build> [-S <path-to-source>]"
msgstr ""

#: ../../../generator/FASTBuild.rst:18
msgid ""
"This writes a FASTBuild configuration file named ``fbuild.bff`` into ``<path-"
"to-build>``."
msgstr ""

#: ../../../generator/FASTBuild.rst:23
msgid ""
"This generator also produces IDE project files for Visual Studio and Xcode, "
"which are placed under:"
msgstr ""

#: ../../../generator/FASTBuild.rst:26
msgid "``<path-to-build>/VisualStudio`` - Visual Studio solution and projects"
msgstr ""

#: ../../../generator/FASTBuild.rst:27
msgid "``<path-to-build>/XCode`` - Xcode workspace and projects"
msgstr ""

#: ../../../generator/FASTBuild.rst:29
msgid ""
"These IDE files can be generated by building ``xcode`` or ``solution`` "
"targets and will build using FASTBuild as the backend."
msgstr ""

#: ../../../generator/FASTBuild.rst:33
msgid "Built-in Targets"
msgstr ""

#: ../../../generator/FASTBuild.rst:37
msgid ""
"When the :variable:`CMAKE_TEST_BUILD_DEPENDS` variable is enabled, the "
"generated build file provides the following targets:"
msgstr ""

#: ../../../generator/FASTBuild.rst:40
msgid "``test_prep/<test-name>``"
msgstr ""

#: ../../../generator/FASTBuild.rst:41
msgid ""
"Builds all known build dependencies for the test named ``<test-name>`` added "
"by :command:`add_test`, including the executable target invoked by the test, "
"targets referenced by generator expressions in the test command, and "
"explicit ``BUILD_DEPENDS`` entries."
msgstr ""

#: ../../../generator/FASTBuild.rst:46
msgid ""
"Tests whose names are not valid target names are excluded. If multiple tests "
"in different directories share the same name, their dependencies are merged "
"into one ``test_prep/<test-name>`` target."
msgstr ""

#: ../../../generator/FASTBuild.rst:50
msgid ""
"Individual ``test_prep/<test-name>`` targets are not created for tests "
"discovered at test time, because their names are not known during generation."
msgstr ""

#: ../../../generator/FASTBuild.rst:53
msgid "``test_prep/all``"
msgstr ""

#: ../../../generator/FASTBuild.rst:54
msgid ""
"Depends on every generated ``test_prep/<test-name>`` target. Also builds "
"dependencies recorded by the :prop_dir:`CMAKE_TEST_BUILD_DEPENDS` directory "
"property."
msgstr ""

#: ../../../generator/FASTBuild.rst:59
msgid "Caching"
msgstr ""

#: ../../../generator/FASTBuild.rst:61
msgid ""
"To enable FASTBuild caching, set the cache path using the :variable:"
"`CMAKE_FASTBUILD_CACHE_PATH` variable or the ``FASTBUILD_CACHE_PATH`` "
"environment variable."
msgstr ""

#: ../../../generator/FASTBuild.rst:65
msgid "Then build with the ``-cache`` flag:"
msgstr ""

#: ../../../generator/FASTBuild.rst:67
msgid "cmake --build <path-to-build> -- -cache"
msgstr ""

