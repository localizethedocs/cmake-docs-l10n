#: ../../../generator/FASTBuild.rst:102
msgid "Target Properties"
msgstr ""

#: ../../../generator/FASTBuild.rst:104
msgid ""
"The following target properties can be used to fine-tune behavior on a per-"
"target basis:"
msgstr ""

#: ../../../generator/FASTBuild.rst:107
msgid ":prop_tgt:`FASTBUILD_CACHING` - disables caching for a specific target."
msgstr ""

#: ../../../generator/FASTBuild.rst:109
msgid ""
":prop_tgt:`FASTBUILD_DISTRIBUTION` - disables distributed compilation for a "
"specific target."
msgstr ""

#: ../../../generator/FASTBuild.rst:113
msgid "Notes"
msgstr ""

#: ../../../generator/FASTBuild.rst:115
msgid ""
"This generator does not support directories as outputs of custom commands. "
"If you do specify a directory as an output, it should be marked with the "
"``SYMBOLIC`` property to avoid incorrect behavior."
msgstr ""

#: ../../../generator/FASTBuild.rst:118
msgid ""
"It is highly advised to use custom commands with only one output. If "
"multiple outputs are specified, the generator will emit an additional rule "
"to check the outputs at build time. This adds overhead and is necessary "
"because FASTBuild natively supports only a single output per custom step."
msgstr ""

#: ../../../generator/FASTBuild.rst:124
msgid "Example"
msgstr ""

#: ../../../generator/FASTBuild.rst:126
msgid ""
"cmake [<options>] -G FASTBuild -B <path-to-build> -"
"DCMAKE_BUILD_TYPE=Release\n"
"cmake --build <path-to-build> --target my_app"
msgstr ""

#: ../../../generator/FASTBuild.rst:131
msgid ""
"This generates ``fbuild.bff`` in ``<path-to-build>`` and uses FASTBuild to "
"build the ``my_app`` target."
msgstr ""

