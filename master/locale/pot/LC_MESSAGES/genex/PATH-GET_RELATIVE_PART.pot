#: ../../../genex/PATH-GET_RELATIVE_PART.rst:2
msgid "PATH:GET_RELATIVE_PART"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/PATH-GET_RELATIVE_PART.rst:10
msgid "$<PATH:GET_RELATIVE_PART,path...>"
msgstr ""

#: ../../../genex/PATH-GET_RELATIVE_PART.rst:14
msgid ""
"Returns the relative part of ``path``, which is the path with its root path "
"removed. If the path has no relative part, an empty string is returned."
msgstr ""

#: ../../../genex/PATH-GET_RELATIVE_PART.rst:17
msgid ""
"CMake now accepts a list of paths as argument. When a list of paths is  "
"specified, the operation will be applied to each path."
msgstr ""

#: ../../../genex/PATH-GET_RELATIVE_PART.rst:21
msgid ""
"If a requested component is not present in the path, an empty string is "
"returned."
msgstr ""
