#: ../../../genex/_0.rst:2 ../../../genex/_0.rst:10
msgid "$<_0>"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/_0.rst:14
msgid ""
"``$<_0>`` is the *bound operand* of the enclosing *binding operation*: a "
"generator expression that evaluates a ``<body>`` once for each value it "
"supplies, with ``$<_0>`` expanding to that value."
msgstr ""

#: ../../../genex/_0.rst:18
msgid ""
"For example, :genex:`$<LIST:TRANSFORM,...,APPLY,body> <LIST:TRANSFORM>` "
"evaluates ``body`` once per list element with ``$<_0>`` bound to the current "
"element."
msgstr ""

#: ../../../genex/_0.rst:22
msgid ""
"``$<_0>`` is only valid inside the body of a binding operation.  Using it "
"anywhere else is an error."
msgstr ""
