#: ../../../genex/TARGET_BUNDLE_CONTENT_DIR.rst:2
msgid "TARGET_BUNDLE_CONTENT_DIR"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/TARGET_BUNDLE_CONTENT_DIR.rst:10
msgid "$<TARGET_BUNDLE_CONTENT_DIR:tgt>"
msgstr ""

#: ../../../genex/TARGET_BUNDLE_CONTENT_DIR.rst:14
msgid ""
"Full path to the bundle content directory where ``tgt`` is the name of a "
"target. For the macOS SDK it leads to ``/path/to/my.app/Contents``, ``/path/"
"to/my.framework``, or ``/path/to/my.bundle/Contents``. For all other SDKs "
"(e.g. iOS) it leads to ``/path/to/my.app``, ``/path/to/my.framework``, or ``/"
"path/to/my.bundle`` due to the flat bundle structure."
msgstr ""

#: ../../../genex/TARGET_BUNDLE_CONTENT_DIR.rst:20
msgid ""
"Note that ``tgt`` is not added as a dependency of the target this expression "
"is evaluated on (see policy :policy:`CMP0112`)."
msgstr ""
