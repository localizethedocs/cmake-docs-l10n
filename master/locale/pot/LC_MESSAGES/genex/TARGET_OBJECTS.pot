#: ../../../genex/TARGET_OBJECTS.rst:2
msgid "TARGET_OBJECTS"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/TARGET_OBJECTS.rst:10
msgid "$<TARGET_OBJECTS:tgt[,SOURCE_FILES:source_file[;source_file]...]>"
msgstr ""

#: ../../../genex/TARGET_OBJECTS.rst:14
msgid ""
"List of objects resulting from building ``tgt``.  This would typically be "
"used on :ref:`object library <Object Libraries>` targets."
msgstr ""

#: ../../../genex/TARGET_OBJECTS.rst:17
msgid "Additional arguments:"
msgstr ""

#: ../../../genex/TARGET_OBJECTS.rst:19
msgid "``SOURCE_FILES:source_file[;source_file]...``"
msgstr ""

#: ../../../genex/TARGET_OBJECTS.rst:23
msgid ""
"An optional :ref:`semicolon-separated list <CMake Language Lists>`  of one "
"or more source files for the target. Only the object files built from those "
"source files will be returned (but not necessarily in the same order they "
"were specified)."
msgstr ""
