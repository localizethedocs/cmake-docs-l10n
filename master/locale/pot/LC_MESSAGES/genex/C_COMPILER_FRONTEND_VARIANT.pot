msgstr ""

#: ../../../genex/C_COMPILER_FRONTEND_VARIANT.rst:29
msgid "With Arguments"
msgstr ""

#: ../../../genex/C_COMPILER_FRONTEND_VARIANT.rst:31
msgid "$<C_COMPILER_FRONTEND_VARIANT:compiler_ids>"
msgstr ""

#: ../../../genex/C_COMPILER_FRONTEND_VARIANT.rst:35
msgid ""
"where ``compiler_ids`` is a comma-separated list. ``1`` if CMake's compiler "
"frontend variant of the C compiler matches any one of the entries in "
"``compiler_ids``, otherwise ``0``."
msgstr ""
