#: ../../../genex/BOOL.rst:2
msgid "BOOL"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/BOOL.rst:9
msgid "$<BOOL:string>"
msgstr ""

#: ../../../genex/BOOL.rst:13
msgid ""
"Converts ``string`` to ``0`` or ``1``. Evaluates to ``0`` if any of the "
"following is true:"
msgstr ""

#: ../../../genex/BOOL.rst:16
msgid "``string`` is empty,"
msgstr ""

#: ../../../genex/BOOL.rst:17
msgid ""
"``string`` is a case-insensitive equal of ``0``, ``FALSE``, ``OFF``, ``N``, "
"``NO``, ``IGNORE``, or ``NOTFOUND``, or"
msgstr ""

#: ../../../genex/BOOL.rst:19
msgid "``string`` ends in the suffix ``-NOTFOUND`` (case-sensitive)."
msgstr ""

#: ../../../genex/BOOL.rst:21
msgid "Otherwise evaluates to ``1``."
msgstr ""
