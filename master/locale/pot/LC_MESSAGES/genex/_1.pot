#: ../../../genex/_1.rst:2 ../../../genex/_1.rst:10
msgid "$<_1>"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/_1.rst:14
msgid ""
"The second *bound operand* of a *binding operation* that binds at least two "
"operands, expanding to the second supplied value."
msgstr ""

#: ../../../genex/_1.rst:17
msgid ""
"For example, :genex:`$<LIST:SORT,...,COMPARATOR,body> <LIST:SORT>` evaluates "
"``body`` once per comparison with :genex:`$<_0>` and ``$<_1>`` bound to the "
"two items being compared."
msgstr ""

#: ../../../genex/_1.rst:21
msgid ""
"``$<_1>`` is only valid inside the body of a binding operation that binds at "
"least two operands.  Using it anywhere else is an error."
msgstr ""
