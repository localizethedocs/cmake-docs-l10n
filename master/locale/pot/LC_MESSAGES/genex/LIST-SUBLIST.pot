#: ../../../genex/LIST-SUBLIST.rst:2
msgid "LIST:SUBLIST"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/LIST-SUBLIST.rst:10
msgid "$<LIST:SUBLIST,list,begin,length>"
msgstr ""

#: ../../../genex/LIST-SUBLIST.rst:14
msgid ""
"A sublist of the given ``list``.  If ``length`` is 0, an empty list will be "
"returned.  If ``length`` is -1 or the list is smaller than ``begin + "
"length``, the remaining items of the list starting at ``begin`` will be "
"returned."
msgstr ""
