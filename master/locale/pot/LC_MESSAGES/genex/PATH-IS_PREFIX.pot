#: ../../../genex/PATH-IS_PREFIX.rst:2
msgid "PATH:IS_PREFIX"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/PATH-IS_PREFIX.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/PATH-IS_PREFIX.rst:11
msgid "$<PATH:IS_PREFIX[,NORMALIZE],path,input>"
msgstr ""

#: ../../../genex/PATH-IS_PREFIX.rst:17
msgid "Returns ``1`` if ``path`` is the prefix of ``input``, ``0`` otherwise."
msgstr ""

#: ../../../genex/PATH-IS_PREFIX.rst:19
msgid ""
"When the ``NORMALIZE`` option is specified, ``path`` and ``input`` "
"are :ref:`normalized <Normalization>` before the check."
msgstr ""

#: ../../../genex/PATH-IS_PREFIX.rst:22
msgid "An empty ``path`` is not a prefix of any ``input``."
msgstr ""

#: ../../../genex/PATH-IS_PREFIX.rst:24
msgid ""
"An empty ``path`` was previously a prefix of every ``input``.  See "
"policy :policy:`CMP0223`."
msgstr ""
