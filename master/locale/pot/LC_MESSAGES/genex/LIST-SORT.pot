#: ../../../genex/LIST-SORT.rst:2
msgid "LIST:SORT"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/LIST-SORT.rst:11
msgid "Synopsis"
msgstr ""

#: ../../../genex/LIST-SORT.rst:23
msgid ""
"`$<LIST:SORT,list[,(COMPARE:option|CASE:option|ORDER:option)]...> <Built-in "
"Options_>`_\n"
"`$<LIST:SORT,list,COMPARATOR,body[,ORDER:ASCENDING|DESCENDING]"
"[,CASE:SENSITIVE|INSENSITIVE]> <Comparator_>`_"
msgstr ""

#: ../../../genex/LIST-SORT.rst:19
msgid "Built-in Options"
msgstr ""

#: ../../../genex/LIST-SORT.rst:21
msgid "$<LIST:SORT,list[,(COMPARE:option|CASE:option|ORDER:option)]...>"
msgstr ""

#: ../../../genex/LIST-SORT.rst:25
msgid "The ``list`` sorted according to the specified options."
msgstr ""

#: ../../../genex/LIST-SORT.rst:27
msgid ""
"Use one of the ``COMPARE`` options to select the comparison method for "
"sorting:"
msgstr ""

#: ../../../genex/LIST-SORT.rst:29
msgid "``STRING``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:30
msgid ""
"Sorts a list of strings alphabetically. This is the default behavior if the "
"``COMPARE`` option is not given."
msgstr ""

#: ../../../genex/LIST-SORT.rst:33
msgid "``FILE_BASENAME``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:34
msgid "Sorts a list of file paths by their basenames."
msgstr ""

#: ../../../genex/LIST-SORT.rst:36
msgid "``NATURAL``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:37
msgid ""
"Sorts a list of strings using natural order (see the man page for "
"``strverscmp(3)``), such that contiguous digits are compared as whole "
"numbers.  For example, the following list ``10.0 1.1 2.1 8.0 2.0 3.1`` will "
"be sorted as ``1.1 2.0 2.1 3.1 8.0 10.0`` if the ``NATURAL`` comparison is "
"selected, whereas it will be sorted as ``1.1 10.0 2.0 2.1 3.1 8.0`` with the "
"``STRING`` comparison."
msgstr ""

#: ../../../genex/LIST-SORT.rst:44
msgid ""
"Use one of the ``CASE`` options to select a case-sensitive or case-"
"insensitive sort mode:"
msgstr ""

#: ../../../genex/LIST-SORT.rst:47
msgid "``SENSITIVE``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:48
msgid ""
"List items are sorted in a case-sensitive manner. This is the default "
"behavior if the ``CASE`` option is not given."
msgstr ""

#: ../../../genex/LIST-SORT.rst:51
msgid "``INSENSITIVE``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:52
msgid ""
"List items are sorted in a case-insensitive manner.  The order of items "
"which differ only by upper/lowercase is not specified."
msgstr ""

#: ../../../genex/LIST-SORT.rst:55
msgid "To control the sort order, one of the ``ORDER`` options can be given:"
msgstr ""

#: ../../../genex/LIST-SORT.rst:57
msgid "``ASCENDING``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:58
msgid ""
"Sorts the list in ascending order. This is the default behavior when the "
"``ORDER`` option is not given."
msgstr ""

#: ../../../genex/LIST-SORT.rst:61
msgid "``DESCENDING``"
msgstr ""

#: ../../../genex/LIST-SORT.rst:62
msgid "Sorts the list in descending order."
msgstr ""

#: ../../../genex/LIST-SORT.rst:64
msgid ""
"Options can be specified in any order, but it is an error to specify the "
"same option multiple times."
msgstr ""

#: ../../../genex/LIST-SORT.rst:67
msgid "$<LIST:SORT,list,CASE:SENSITIVE,COMPARE:STRING,ORDER:DESCENDING>"
msgstr ""

#: ../../../genex/LIST-SORT.rst:72
msgid "Comparator"
msgstr ""

#: ../../../genex/LIST-SORT.rst:76
msgid ""
"A ``COMPARATOR`` option sorts using a generator-expression ``body`` instead "
"of a built-in ordering:"
msgstr ""

#: ../../../genex/LIST-SORT.rst:79
msgid ""
"$<LIST:SORT,list,COMPARATOR,body[,ORDER:ASCENDING|DESCENDING]"
"[,CASE:SENSITIVE|INSENSITIVE]>"
msgstr ""

#: ../../../genex/LIST-SORT.rst:83
msgid ""
"``body`` is evaluated once per comparison with the two items being compared "
"bound to :genex:`$<_0>` and :genex:`$<_1>`.  It must evaluate to exactly "
"``0`` or ``1``; ``1`` means :genex:`$<_0>` sorts before :genex:`$<_1>`. "
"``COMPARATOR`` is incompatible with ``COMPARE:``.  ``ORDER:DESCENDING`` "
"reverses the comparator and ``CASE:INSENSITIVE`` case-folds the values the "
"body sees, both as in the configure-time :command:`list(SORT)`.  The body "
"must induce a `strict weak ordering <https://en.wikipedia.org/wiki/"
"Weak_ordering#Strict_weak_orderings>`_."
msgstr ""
