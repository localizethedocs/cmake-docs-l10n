#: ../../../genex/LINK_ONLY.rst:2
msgid "LINK_ONLY"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/LINK_ONLY.rst:10
msgid "$<LINK_ONLY:...>"
msgstr ""

#: ../../../genex/LINK_ONLY.rst:14
msgid ""
"Content of ``...``, except while collecting usage requirements "
"from :ref:`transitive compile properties <Transitive Compile Properties>`, "
"in which case it is the empty string.  This is intended for use in "
"an :prop_tgt:`INTERFACE_LINK_LIBRARIES` target property, typically populated "
"via the :command:`target_link_libraries` command, to specify private link "
"dependencies without other usage requirements such as include directories or "
"compile options."
msgstr ""

#: ../../../genex/LINK_ONLY.rst:22
msgid ""
"``LINK_ONLY`` may also be used in a :prop_tgt:`LINK_LIBRARIES` target "
"property.  See policy :policy:`CMP0131`."
msgstr ""
