#: ../../../genex/SOURCE_PROPERTY.rst:2
msgid "SOURCE_PROPERTY"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:11
msgid "$<SOURCE_PROPERTY:src[,(DIRECTORY:dir|TARGET_DIRECTORY:target)],prop>"
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:17
msgid ""
"Value of the property ``prop`` on the source file ``src``, or empty if the "
"property is not set. An error will be raised if the source file is not known "
"by CMake. By default, the source file's property will be read from the "
"current source directory's scope or the directory of the consuming target."
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:22
msgid ""
"Directory scope can be overridden with one of the following sub-options:"
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:24
msgid "``DIRECTORY:dir``"
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:25
msgid ""
"The source file property will be read from the ``dir`` directory's scope. "
"CMake must know about the directory, either by having added  it through a "
"call to :command:`add_subdirectory` or ``dir`` being the top level "
"directory. Relative paths are treated as relative to the current source "
"directory."
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:31
msgid "``TARGET_DIRECTORY:target``"
msgstr ""

#: ../../../genex/SOURCE_PROPERTY.rst:32
msgid ""
"The source file property will be read from the directory scope in which "
"``target`` was created (``target`` must therefore exist)."
msgstr ""
