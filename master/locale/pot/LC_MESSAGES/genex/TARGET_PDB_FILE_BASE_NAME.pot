#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:2
msgid "TARGET_PDB_FILE_BASE_NAME"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:11
msgid "$<TARGET_PDB_FILE_BASE_NAME:tgt[,POSTFIX:(INCLUDE|EXCLUDE)]>"
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:17
msgid ""
"Base name of the linker generated program database file (.pdb) where ``tgt`` "
"is the name of a target."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:20
msgid ""
"The ``POSTFIX`` option can be used to control the inclusion or not of "
"the :prop_tgt:`<CONFIG>_POSTFIX` target property value as part of the base "
"name. The default is ``POSTFIX:INCLUDE``."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:25
msgid ""
"The postfix, as specified by :prop_tgt:`DEBUG_POSTFIX` "
"or :prop_tgt:`<CONFIG>_POSTFIX` target properties, is always included in the "
"``PDB`` base name, except if the ``POSTFIX`` option has the value "
"``EXCLUDE``.  See the policy :policy:`CMP0202`."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:31
msgid ""
"The base name corresponds to the target PDB file name (see "
"``$<TARGET_PDB_FILE_NAME:tgt>``) without prefix and suffix, and, optionally, "
"postfix.  For example, if the target file name is ``base_postfix.pdb``, the "
"base name is"
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:36
msgid ""
"``base_postfix`` for ``$<TARGET_PDB_FILE_BASE_NAME:tgt>`` or "
"``$<TARGET_PDB_FILE_BASE_NAME:tgt,POSTFIX:INCLUDE>``."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:38
msgid "``base`` for ``$<TARGET_PDB_FILE_BASE_NAME:tgt,POSTFIX:EXCLUDE>``."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:40
msgid ""
"See also the :prop_tgt:`OUTPUT_NAME` and :prop_tgt:`PDB_NAME` target "
"properties, their configuration-specific "
"variants :prop_tgt:`OUTPUT_NAME_<CONFIG>` and :prop_tgt:`PDB_NAME_<CONFIG>`, "
"and the :prop_tgt:`<CONFIG>_POSTFIX` and :prop_tgt:`DEBUG_POSTFIX` target "
"properties."
msgstr ""

#: ../../../genex/TARGET_PDB_FILE_BASE_NAME.rst:45
msgid ""
"Note that ``tgt`` is not added as a dependency of the target this expression "
"is evaluated on."
msgstr ""
