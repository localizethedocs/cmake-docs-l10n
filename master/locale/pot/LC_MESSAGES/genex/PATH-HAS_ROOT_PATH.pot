#: ../../../genex/PATH-HAS_ROOT_PATH.rst:2
msgid "PATH:HAS_ROOT_PATH"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/PATH-HAS_ROOT_PATH.rst:10
msgid "$<PATH:HAS_ROOT_PATH,path>"
msgstr ""

#: ../../../genex/PATH-HAS_ROOT_PATH.rst:14
msgid ""
"Returns ``1`` if ``path`` has a root path, ``0`` otherwise. The root path is "
"the root name followed by the root directory separator; either component may "
"be empty."
msgstr ""

#: ../../../genex/PATH-HAS_ROOT_PATH.rst:18
msgid ""
"The result is true only if at least one of the root name or root directory "
"separator is present."
msgstr ""
