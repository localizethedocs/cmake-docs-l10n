#: ../../../genex/PATH-HAS_PARENT_PATH.rst:2
msgid "PATH:HAS_PARENT_PATH"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/PATH-HAS_PARENT_PATH.rst:10
msgid "$<PATH:HAS_PARENT_PATH,path>"
msgstr ""

#: ../../../genex/PATH-HAS_PARENT_PATH.rst:14
msgid ""
"Returns ``1`` if ``path`` has a parent path, ``0`` otherwise. The parent "
"path is the path with its filename removed."
msgstr ""

#: ../../../genex/PATH-HAS_PARENT_PATH.rst:17
msgid ""
"Note that the root directory is also considered to have a parent, which will "
"be itself.  The result is true except if the path consists of just "
"a :ref:`filename <FILENAME_DEF>`."
msgstr ""
