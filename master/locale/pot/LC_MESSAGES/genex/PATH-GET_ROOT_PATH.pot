#: ../../../genex/PATH-GET_ROOT_PATH.rst:2
msgid "PATH:GET_ROOT_PATH"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/PATH-GET_ROOT_PATH.rst:10
msgid "$<PATH:GET_ROOT_PATH,path...>"
msgstr ""

#: ../../../genex/PATH-GET_ROOT_PATH.rst:14
msgid ""
"Returns the root path of ``path``, formed by its root name followed by its "
"root directory separator. Either component may be empty. If neither is "
"present, an empty string is returned."
msgstr ""

#: ../../../genex/PATH-GET_ROOT_PATH.rst:18
msgid ""
"CMake now accepts a list of paths as argument. When a list of paths is  "
"specified, the operation will be applied to each path."
msgstr ""

#: ../../../genex/PATH-GET_ROOT_PATH.rst:22
msgid ""
"If a requested component is not present in the path, an empty string is "
"returned."
msgstr ""
