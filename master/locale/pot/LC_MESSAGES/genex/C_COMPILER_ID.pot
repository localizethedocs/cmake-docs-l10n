#: ../../../genex/C_COMPILER_ID.rst:2
msgid "C_COMPILER_ID"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:10
msgid "Synopsis"
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:22
msgid ""
"`$<C_COMPILER_ID> <Without Arguments_>`_\n"
"`$<C_COMPILER_ID:compiler_ids> <With Arguments_>`_"
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:18
msgid "Without Arguments"
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:20
msgid "$<C_COMPILER_ID>"
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:24
msgid "CMake's compiler id of the C compiler used."
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:27
msgid "With Arguments"
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:29
msgid "$<C_COMPILER_ID:compiler_ids>"
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:33
msgid ""
"where ``compiler_ids`` is a comma-separated list. ``1`` if CMake's compiler "
"id of the C compiler matches any one of the entries in ``compiler_ids``, "
"otherwise ``0``."
msgstr ""

#: ../../../genex/C_COMPILER_ID.rst:37
msgid ""
"Multiple ``compiler_ids`` can be specified. CMake 3.14 and earlier only "
"accepted a single compiler ID."
msgstr ""
