msgid "STRING:MATCH"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-MATCH.rst:10
msgid "Syntax"
msgstr ""

#: ../../../genex/STRING-MATCH.rst:12
msgid "$<STRING:MATCH,string[,SEEK:(ONCE|ALL)],regular_expression>"
msgstr ""

#: ../../../genex/STRING-MATCH.rst:18
msgid "Match, in the ``string``, the ``regular_expression``."
msgstr ""

#: ../../../genex/STRING-MATCH.rst:20
msgid "The ``SEEK:`` option specifies the match behavior:"
msgstr ""

#: ../../../genex/STRING-MATCH.rst:22
msgid "``ONCE``"
msgstr ""

#: ../../../genex/STRING-MATCH.rst:23
msgid "Match only the first occurrence. This is the default."
msgstr ""

#: ../../../genex/STRING-MATCH.rst:25
msgid "``ALL``"
msgstr ""

#: ../../../genex/STRING-MATCH.rst:26
msgid "Match as many times as possible and return the matches as a list."
msgstr ""

#: ../../../genex/STRING-MATCH.rst:28
msgid ""
"See the :ref:`CMake Language Regex Specification` for the syntax of the "
"``regular_expression`` parameter."
msgstr ""
