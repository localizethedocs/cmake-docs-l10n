#: ../../../genex/IF.rst:2
msgid "IF"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/IF.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/IF.rst:11
msgid "$<IF:condition,true_string,false_string>"
msgstr ""

#: ../../../genex/IF.rst:17
msgid ""
"Evaluates to ``true_string`` if ``condition`` is ``1``, or ``false_string`` "
"if ``condition`` is ``0``.  Any other value for ``condition`` results in an "
"error."
msgstr ""

#: ../../../genex/IF.rst:22
msgid ""
"This generator expression short-circuits such that generator expressions in "
"``false_string`` will not evaluate when ``condition`` is ``1``, and "
"generator expressions in ``true_string`` will not evaluate when condition is "
"``0``."
msgstr ""
