#: ../../../../Modules/FindLAPACK.cmake:6
msgid "FindLAPACK"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:8
msgid ""
"Finds the installed Linear Algebra PACKage (LAPACK) Fortran library that "
"implements the `LAPACK linear-algebra interface`_:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:11
msgid "find_package(LAPACK [...])"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:15
msgid ""
"At least one of the ``C``, ``CXX``, or ``Fortran`` languages must be enabled."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:20
msgid "Imported Targets"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:22
msgid "This module provides the following :ref:`Imported Targets`:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:24
msgid "``LAPACK::LAPACK``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:27
msgid ""
"Target encapsulating the LAPACK usage requirements, available only if LAPACK "
"is found."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:31
msgid "Result Variables"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:33
msgid "This module defines the following variables:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:35
msgid "``LAPACK_FOUND``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:36
msgid ""
"Boolean indicating whether the library implementing the LAPACK interface was "
"found."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:38
msgid "``LAPACK_LINKER_FLAGS``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:39
msgid ""
"List of required linker flags, excluding ``-l`` and ``-L``, to pass to :"
"command:`target_link_options`."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:41
msgid "``LAPACK_LIBRARIES``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:42
msgid ""
"List of libraries to link via :command:`target_link_libraries` to use LAPACK."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:44
msgid "``LAPACK95_LIBRARIES``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:45
msgid ""
"List of libraries to link via :command:`target_link_libraries` to use "
"LAPACK95."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:47
msgid "``LAPACK95_FOUND``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:48
msgid ""
"Boolean indicating whether the library implementing the LAPACK95 interface "
"was found."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:52
msgid "Input Variables"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:54
msgid "The following variables may be set to influence this module's behavior:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:56
msgid "``BLA_STATIC``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:57
msgid "If ``ON``, the static linkage will be used."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:59
msgid "``BLA_VENDOR``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:60
msgid ""
"Set to one of the :ref:`BLAS/LAPACK Vendors` to search for BLAS only from "
"the specified vendor.  If not set, all vendors are considered."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:63
msgid "``BLA_F95``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:64
msgid "If ``ON``, the module tries to find the BLAS95/LAPACK95 interfaces."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:66
msgid "``BLA_PREFER_PKGCONFIG``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:69
msgid ""
"If set, ``pkg-config`` will be used to search for a LAPACK library first and "
"if one is found that is preferred."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:72
msgid "``BLA_PKGCONFIG_LAPACK``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:75
msgid ""
"If set, the ``pkg-config`` method will look for this module name instead of "
"just ``lapack``."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:78
msgid "``BLA_SIZEOF_INTEGER``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:81
msgid "Specify the BLAS/LAPACK library integer size:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:83
msgid "``4``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:84
msgid "Search for a BLAS/LAPACK with 32-bit integer interfaces."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:85
msgid "``8``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:86
msgid "Search for a BLAS/LAPACK with 64-bit integer interfaces."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:87
#: ../../../../Modules/FindLAPACK.cmake:100
msgid "``ANY``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:88
msgid ""
"Search for any BLAS/LAPACK. Most likely, a BLAS/LAPACK with 32-bit integer "
"interfaces will be found."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:91
msgid "``BLA_THREAD``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:94
msgid "Specify the BLAS/LAPACK threading model:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:96
msgid "``SEQ``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:97
msgid "Sequential model"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:98
msgid "``OMP``"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:99
msgid "OpenMP model"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:101
msgid ""
"Search for any BLAS/LAPACK, if both are available most likely ``OMP`` will "
"be found."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:104
msgid "This is currently only supported by NVIDIA NVPL."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:107
msgid "Intel MKL"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:109
msgid ""
"To use the Intel MKL implementation of LAPACK, a project must enable at "
"least one of the ``C`` or ``CXX`` languages.  Set ``BLA_VENDOR`` to an Intel "
"MKL variant either on the command-line as ``-DBLA_VENDOR=Intel10_64lp`` or "
"in project code:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:114
msgid ""
"set(BLA_VENDOR Intel10_64lp)\n"
"find_package(LAPACK)"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:119
msgid ""
"In order to build a project using Intel MKL, and end user must first "
"establish an Intel MKL environment.  See the :module:`FindBLAS` module "
"section on :ref:`Intel MKL` for details."
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:124
msgid "Examples"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:126
msgid "Finding LAPACK and linking it to a project target:"
msgstr ""

#: ../../../../Modules/FindLAPACK.cmake:128
msgid ""
"find_package(LAPACK)\n"
"target_link_libraries(project_target PRIVATE LAPACK::LAPACK)"
msgstr ""
