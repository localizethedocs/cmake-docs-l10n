#: ../../../genex/STRING-FIND.rst:2
msgid "STRING:FIND"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-FIND.rst:10
msgid "Syntax"
msgstr ""

#: ../../../genex/STRING-FIND.rst:12
msgid "$<STRING:FIND,string[,FROM:(BEGIN|END)],substring>"
msgstr ""

#: ../../../genex/STRING-FIND.rst:18
msgid ""
"The position where the given ``substring`` was found in the supplied "
"``string``. If the ``substring`` is not found, a position of -1 is returned."
msgstr ""

#: ../../../genex/STRING-FIND.rst:21
msgid "The ``FROM:`` option defines how the search will be done:"
msgstr ""

#: ../../../genex/STRING-FIND.rst:23
msgid "``BEGIN``"
msgstr ""

#: ../../../genex/STRING-FIND.rst:24
msgid ""
"The search will start at the beginning of the ``string``. This the default."
msgstr ""

#: ../../../genex/STRING-FIND.rst:26
msgid "``END``"
msgstr ""

#: ../../../genex/STRING-FIND.rst:27
msgid "The search will start from the end of the ``string``."
msgstr ""

#: ../../../genex/STRING-FIND.rst:29
msgid ""
"The ``$<STRING:FIND>`` generator expression treats all strings as ASCII-only "
"characters. The index returned will also be counted in bytes, so strings "
"containing multi-byte characters may lead to unexpected results."
msgstr ""
