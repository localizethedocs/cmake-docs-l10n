#: ../../../prop_rule/INCLUDE_DIRECTORIES.rst:2
msgid "INCLUDE_DIRECTORIES"
msgstr ""

#: ../../../prop_rule/INCLUDE_DIRECTORIES.rst:6
msgid "List of preprocessor include file search directories."
msgstr ""

#: ../../../prop_rule/INCLUDE_DIRECTORIES.rst:8
msgid ""
"The ``INCLUDE_DIRECTORIES`` property may be set to a :ref:`semicolon-"
"separated list <CMake Language Lists>` of directories given so far to the :"
"command:`set_property(RULE)` command."
msgstr ""

#: ../../../prop_rule/INCLUDE_DIRECTORIES.rst:12
msgid ""
"The value of this property is used by the rule definitions to set the "
"include paths for the compiler."
msgstr ""

#: ../../../prop_rule/INCLUDE_DIRECTORIES.rst:15
msgid "Relative paths should not be added to this property."
msgstr ""

#: ../../../prop_rule/INCLUDE_DIRECTORIES.rst:17
msgid ""
"Contents of ``INCLUDE_DIRECTORIES`` may use :manual:`generator expressions "
"<cmake-generator-expressions(7)>` with the syntax ``$<...>``. See the :"
"manual:`cmake-buildsystem(7)` manual for more on defining buildsystem "
"properties."
msgstr ""
