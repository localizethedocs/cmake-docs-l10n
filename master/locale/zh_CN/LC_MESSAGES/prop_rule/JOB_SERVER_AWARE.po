#: ../../../prop_rule/JOB_SERVER_AWARE.rst:2
msgid "JOB_SERVER_AWARE"
msgstr ""

#: ../../../prop_rule/JOB_SERVER_AWARE.rst:6
msgid ""
"``JOB_SERVER_AWARE`` is a boolean specifying that the commands produced by "
"the instantiation of the rule are GNU Make job server aware."
msgstr ""

#: ../../../prop_rule/JOB_SERVER_AWARE.rst:9
msgid ""
"For the :generator:`Unix Makefiles`, :generator:`MSYS Makefiles`, and :"
"generator:`MinGW Makefiles` generators this will add the ``+`` prefix to the "
"recipe line. See the `GNU Make Documentation`_ for more information."
msgstr ""

#: ../../../prop_rule/JOB_SERVER_AWARE.rst:13
msgid "This option is ignored by other generators."
msgstr ""
