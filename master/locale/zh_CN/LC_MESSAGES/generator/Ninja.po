#: ../../../generator/Ninja.rst:2
msgid "Ninja"
msgstr ""

#: ../../../generator/Ninja.rst:4
msgid "Generates a ``build.ninja`` file into the build tree."
msgstr ""

#: ../../../generator/Ninja.rst:7
msgid "Built-In Targets"
msgstr ""

#: ../../../generator/Ninja.rst:9
msgid "``all``"
msgstr ""

#: ../../../generator/Ninja.rst:11
msgid ""
"Depends on all targets required by the project, except those with :prop_tgt:"
"`EXCLUDE_FROM_ALL` set to true."
msgstr ""

#: ../../../generator/Ninja.rst:14
msgid "``install``"
msgstr ""

#: ../../../generator/Ninja.rst:16
msgid "Runs the install step."
msgstr ""

#: ../../../generator/Ninja.rst:18
msgid "``install/strip``"
msgstr ""

#: ../../../generator/Ninja.rst:22
msgid "Runs the install followed by a ``CMAKE_STRIP`` command, if any."
msgstr ""

#: ../../../generator/Ninja.rst:24
msgid ""
"The ``CMAKE_STRIP`` variable will contain the platform's ``strip`` utility, "
"which removes symbols information from generated binaries."
msgstr ""

#: ../../../generator/Ninja.rst:27
msgid "``install/parallel``"
msgstr ""

#: ../../../generator/Ninja.rst:31
msgid ""
"Created only if the :prop_gbl:`INSTALL_PARALLEL` global property is ``ON``. "
"Runs the install step for each subdirectory independently and in parallel."
msgstr ""

#: ../../../generator/Ninja.rst:34
msgid "``install_prep/<component>``"
msgstr ""

#: ../../../generator/Ninja.rst:38
msgid ""
"Created if the project has install rules, unless the :variable:"
"`CMAKE_SKIP_INSTALL_PREP_TARGETS` or :variable:`CMAKE_SKIP_INSTALL_RULES` "
"variable is enabled. Builds all known build dependencies for the named "
"install component. Components whose names cannot be represented safely are "
"excluded. See :ref:`Install Preparation Targets` and :ref:`Target Names`."
msgstr ""

#: ../../../generator/Ninja.rst:45
msgid "``install_prep/all``"
msgstr ""

#: ../../../generator/Ninja.rst:49
msgid ""
"Created if the project has install rules, unless the :variable:"
"`CMAKE_SKIP_INSTALL_PREP_TARGETS` or :variable:`CMAKE_SKIP_INSTALL_RULES` "
"variable is enabled. Builds all known build dependencies for an installation "
"that does not select a component. See :ref:`Install Preparation Targets`."
msgstr ""

#: ../../../generator/Ninja.rst:55
msgid "``test_prep/<test-name>``"
msgstr ""

#: ../../../generator/Ninja.rst:59
msgid ""
"Created unless the :variable:`CMAKE_SKIP_TEST_PREP_TARGETS` variable is "
"enabled. Builds all known build dependencies for the named test, including "
"the executable target invoked by the test, targets referenced by generator "
"expressions in the test command, and explicit ``BUILD_DEPENDS`` entries."
msgstr ""

#: ../../../generator/Ninja.rst:64
msgid ""
"Tests with names that are not valid target names are excluded. If multiple "
"tests in different directories share the same name, their dependencies are "
"merged into one ``test_prep/<test-name>`` target. See the :manual:`cmake-"
"buildsystem(7)` manual for more details on :ref:`Target Names`."
msgstr ""

#: ../../../generator/Ninja.rst:70
msgid ""
"Individual ``test_prep/<test-name>`` targets are not created for tests "
"discovered at test time, because their names are not known during generation."
msgstr ""

#: ../../../generator/Ninja.rst:76
msgid ""
"These targets are created by default. In CMake 4.4, they were created only "
"if the :variable:`CMAKE_TEST_BUILD_DEPENDS` variable was enabled."
msgstr ""

#: ../../../generator/Ninja.rst:79
msgid "``test_prep/all``"
msgstr ""

#: ../../../generator/Ninja.rst:83
msgid ""
"Created unless the :variable:`CMAKE_SKIP_TEST_PREP_TARGETS` variable is "
"enabled. Depends on every generated ``test_prep/<test-name>`` target. Also "
"builds dependencies recorded by the :prop_dir:`CMAKE_TEST_BUILD_DEPENDS` "
"directory property."
msgstr ""

#: ../../../generator/Ninja.rst:90
msgid ""
"This target is created by default. In CMake 4.4, it was created only if the :"
"variable:`CMAKE_TEST_BUILD_DEPENDS` variable was enabled."
msgstr ""

#: ../../../generator/Ninja.rst:93
msgid ""
"For each subdirectory ``sub/dir`` of the project, additional targets are "
"generated:"
msgstr ""

#: ../../../generator/Ninja.rst:96
msgid "``sub/dir/all``"
msgstr ""

#: ../../../generator/Ninja.rst:100
msgid "Depends on all targets required by the subdirectory."
msgstr ""

#: ../../../generator/Ninja.rst:102
msgid "``sub/dir/install``"
msgstr ""

#: ../../../generator/Ninja.rst:106
msgid "Runs the install step in the subdirectory, if any."
msgstr ""

#: ../../../generator/Ninja.rst:108
msgid "``sub/dir/install/strip``"
msgstr ""

#: ../../../generator/Ninja.rst:112
msgid ""
"Runs the install step in the subdirectory followed by a ``CMAKE_STRIP`` "
"command, if any."
msgstr ""

#: ../../../generator/Ninja.rst:115
msgid "``sub/dir/test``"
msgstr ""

#: ../../../generator/Ninja.rst:119
msgid "Runs the test step in the subdirectory, if any."
msgstr ""

#: ../../../generator/Ninja.rst:121
msgid "``sub/dir/package``"
msgstr ""

#: ../../../generator/Ninja.rst:125
msgid "Runs the package step in the subdirectory, if any."
msgstr ""

