#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:2
msgid "SYCL_CXX_STANDARD"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:7
msgid "Experimental. Gated by ``CMAKE_EXPERIMENTAL_SYCL``."
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:9
msgid ""
"The C++ standard whose features are requested for SYCL compilations of this "
"target."
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:12
msgid ""
"This property specifies the C++ standard whose features are requested for "
"SYCL compilations of this target.  For some compilers, this results in "
"adding a flag such as ``-std=gnu++20`` to the compile line.  It selects the "
"C++ language version, not the SYCL specification version."
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:17
msgid "Supported values are:"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:19
msgid "``98``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:20
msgid "C++98"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:22
msgid "``11``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:23
msgid "C++11"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:25
msgid "``14``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:26
msgid "C++14"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:28
msgid "``17``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:29
msgid "C++17"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:31
msgid "``20``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:32
msgid "C++20"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:34
msgid "``23``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:35
msgid "C++23"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:37
msgid "``26``"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:38
msgid "C++26"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:40
msgid ""
"If the value requested does not result in a compile flag being added for the "
"compiler in use, a previous standard flag will be added instead.  This means "
"that using:"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:44
msgid "set_property(TARGET tgt PROPERTY SYCL_CXX_STANDARD 11)"
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:48
msgid ""
"with a compiler which does not support ``-std=gnu++11`` or an equivalent "
"flag will not result in an error or warning, but will instead add the ``-"
"std=gnu++98`` flag if supported.  This \"decay\" behavior may be controlled "
"with the :prop_tgt:`SYCL_CXX_STANDARD_REQUIRED` target property. "
"Additionally, the :prop_tgt:`SYCL_EXTENSIONS` target property may be used to "
"control whether compiler-specific extensions are enabled on a per-target "
"basis."
msgstr ""

#: ../../../include/COMPILE_FEATURES_NOTE.rst:2
msgid ""
"See the :manual:`cmake-compile-features(7)` manual for information on "
"compile features and a list of supported compilers."
msgstr ""

#: ../../../prop_tgt/SYCL_CXX_STANDARD.rst:57
msgid ""
"This property is initialized by the value of the :variable:"
"`CMAKE_SYCL_CXX_STANDARD` variable if it is set when a target is created."
msgstr ""
