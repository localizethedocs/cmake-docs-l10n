#: ../../../genex/PATH-HAS_.rst:2
msgid "PATH:HAS_*"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/PATH-HAS_.rst:12
msgid "Syntax"
msgstr ""

#: ../../../genex/PATH-HAS_.rst:14
msgid "$<PATH:HAS_*,path>"
msgstr ""

#: ../../../genex/PATH-HAS_.rst:20
msgid ""
"The following operations return ``1`` if the particular path component is "
"present, ``0`` otherwise. See :ref:`Path Structure And Terminology` for the "
"meaning of each path component."
msgstr ""

#: ../../../genex/PATH-HAS_.rst:24
msgid ""
"$<PATH:HAS_ROOT_NAME,path>\n"
"$<PATH:HAS_ROOT_DIRECTORY,path>\n"
"$<PATH:HAS_ROOT_PATH,path>\n"
"$<PATH:HAS_FILENAME,path>\n"
"$<PATH:HAS_EXTENSION,path>\n"
"$<PATH:HAS_STEM,path>\n"
"$<PATH:HAS_RELATIVE_PART,path>\n"
"$<PATH:HAS_PARENT_PATH,path>"
msgstr ""

#: ../../../genex/PATH-HAS_.rst:35
msgid "Note the following special cases:"
msgstr ""

#: ../../../genex/PATH-HAS_.rst:37
msgid ""
"For ``HAS_ROOT_PATH``, a true result will only be returned if at least one "
"of ``root-name`` or ``root-directory`` is non-empty."
msgstr ""

#: ../../../genex/PATH-HAS_.rst:40
msgid ""
"For ``HAS_PARENT_PATH``, the root directory is also considered to have a "
"parent, which will be itself.  The result is true except if the path "
"consists of just a :ref:`filename <FILENAME_DEF>`."
msgstr ""
