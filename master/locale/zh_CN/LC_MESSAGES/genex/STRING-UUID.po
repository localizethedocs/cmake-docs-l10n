#: ../../../genex/STRING-UUID.rst:2
msgid "STRING:UUID"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-UUID.rst:10
msgid "Syntax"
msgstr ""

#: ../../../genex/STRING-UUID.rst:12
msgid ""
"$<STRING:UUID,NAMESPACE:namespace,TYPE:(MD5|SHA1)[,NAME:name][,CASE:(LOWER|"
"UPPER)]>"
msgstr ""

#: ../../../genex/STRING-UUID.rst:18
msgid ""
"Create a universally unique identifier (aka GUID) as per RFC4122. A UUID has "
"the format ``xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx`` where each ``x`` "
"represents an hexadecimal character."
msgstr ""

#: ../../../genex/STRING-UUID.rst:22
msgid "The UUID is based on the hash of the combined values of:"
msgstr ""

#: ../../../genex/STRING-UUID.rst:24
msgid "``NAMESPACE:namespace``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:25
msgid "``namespace`` which has to be a valid UUID."
msgstr ""

#: ../../../genex/STRING-UUID.rst:27
msgid "``NAME:name``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:28
msgid "``name`` is an arbitrary string."
msgstr ""

#: ../../../genex/STRING-UUID.rst:30
msgid "``TYPE:``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:31
msgid "The hash algorithm can be either:"
msgstr ""

#: ../../../genex/STRING-UUID.rst:33
msgid "``MD5``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:34
msgid "Version 3 UUID."
msgstr ""

#: ../../../genex/STRING-UUID.rst:36
msgid "``SHA1``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:37
msgid "Version 5 UUID."
msgstr ""

#: ../../../genex/STRING-UUID.rst:39
msgid "``CASE:``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:40
msgid "Specify the case of the hexadecimal characters."
msgstr ""

#: ../../../genex/STRING-UUID.rst:42
msgid "``LOWER``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:43
msgid "Hexadecimal characters are all of lowercase. This is the default."
msgstr ""

#: ../../../genex/STRING-UUID.rst:45
msgid "``UPPER``"
msgstr ""

#: ../../../genex/STRING-UUID.rst:46
msgid "Hexadecimal characters are all of uppercase."
msgstr ""
