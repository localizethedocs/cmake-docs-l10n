msgid "OR"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/OR.rst:8
msgid "Syntax"
msgstr ""

#: ../../../genex/OR.rst:10
msgid "$<OR:conditions>"
msgstr ""

#: ../../../genex/OR.rst:14
msgid ""
"where ``conditions`` is a comma-separated list of boolean expressions. all "
"of which must evaluate to either ``1`` or ``0``.  The whole expression "
"evaluates to ``1`` if at least one of the ``conditions`` is ``1``.  If all "
"``conditions`` evaluate to ``0``, the whole expression evaluates to ``0``."
msgstr ""
