#: ../../../genex/STRING-RANDOM.rst:2
msgid "STRING:RANDOM"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:10
msgid "Syntax"
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:12
msgid ""
"$<STRING:RANDOM[,(LENGTH:length|ALPHABET:alphabet|RANDOM_SEED:seed)]...>"
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:18
msgid "Produce a random string of ASCII characters. The possible options are:"
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:20
msgid "``LENGTH:length``"
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:21
msgid "Define the length of the string. The default length is 5 characters."
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:23
msgid "``ALPHABET:alphabet``"
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:24
msgid ""
"Define the characters used for the generation. The alphabet is always "
"interpreted as holding ASCII characters. The default alphabet is all numbers "
"and upper and lower case letters."
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:28
msgid "``RANDOM_SEED:seed``"
msgstr ""

#: ../../../genex/STRING-RANDOM.rst:29
msgid ""
"Specify an integer which will be used to seed the random number generator."
msgstr ""
