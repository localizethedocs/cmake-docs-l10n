#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:2
msgid "SYCL_RESOLVE_DEVICE_SYMBOLS"
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:7
msgid "Experimental. Gated by ``CMAKE_EXPERIMENTAL_SYCL``."
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:9
msgid ""
"SYCL only: Enables device linking for the specific library target where "
"required."
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:12
msgid ""
"If set, this will tell the required compilers to enable device linking on "
"the library target. Device linking is an additional link step required by "
"some SYCL compilers when :prop_tgt:`SYCL_SEPARABLE_COMPILATION` is enabled. "
"Normally device linking is deferred until a shared library or executable is "
"generated, allowing for multiple static libraries to resolve device symbols "
"at the same time when they are used by a shared library or executable."
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:20
msgid ""
"If this property or :variable:`CMAKE_SYCL_RESOLVE_DEVICE_SYMBOLS` is unset, "
"static libraries are treated as if it is disabled while shared, module, and "
"executable targets behave as if it is on."
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:24
msgid ""
"If :variable:`CMAKE_SYCL_RESOLVE_DEVICE_SYMBOLS` has been defined, this "
"property is initialized to the value the variable and overriding the default "
"behavior."
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:28
msgid "Note that device linking is not supported for :ref:`Object Libraries`."
msgstr ""

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:31
msgid "For instance:"
msgstr "例如："

#: ../../../prop_tgt/SYCL_RESOLVE_DEVICE_SYMBOLS.rst:33
msgid ""
"set_property(TARGET mystaticlib PROPERTY SYCL_RESOLVE_DEVICE_SYMBOLS ON)"
msgstr ""
