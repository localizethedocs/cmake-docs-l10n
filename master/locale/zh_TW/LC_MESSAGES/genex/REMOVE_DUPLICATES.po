#: ../../../genex/REMOVE_DUPLICATES.rst:2
msgid "REMOVE_DUPLICATES"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/REMOVE_DUPLICATES.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/REMOVE_DUPLICATES.rst:11
msgid "$<REMOVE_DUPLICATES:list>"
msgstr ""

#: ../../../genex/REMOVE_DUPLICATES.rst:17
msgid ""
"Removes duplicated items in the given ``list``. The relative order of items "
"is preserved, and if duplicates are encountered, only the first instance is "
"retained.  The result is the same as :cref:`$"
"\\<LIST:REMOVE_DUPLICATES,list\\> <GenEx LIST-REMOVE_DUPLICATES>`."
msgstr ""
