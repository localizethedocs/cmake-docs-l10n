#: ../../../genex/STRING-REPLACE.rst:2
msgid "STRING:REPLACE"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:10
msgid "Syntax"
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:12
msgid "$<STRING:REPLACE[,(STRING|REGEX)],string,match_string,replace_string>"
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:18
msgid ""
"Replace all occurrences of ``match_string`` in the ``string`` with "
"``replace_string``."
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:21
msgid "The ``match_string`` can be of two different types:"
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:23
msgid "``STRING``"
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:24
msgid ""
"``match_string`` is a literal string and match will be done by simple string "
"comparison. This is the default."
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:27
msgid "``REGEX``"
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:28
msgid ""
"``match_string`` is a regular expression. Match this regular_expression as "
"many times as possible and substitute the ``replace_string`` for the match "
"in the ``string``."
msgstr ""

#: ../../../genex/STRING-REPLACE.rst:32
msgid ""
"The ``replace_string`` may refer to parenthesis-delimited subexpressions of "
"the match using \\\\1, \\\\2, ..., \\\\9. Note that two backslashes (\\\\\\"
"\\1) are required in CMake code to get a backslash through argument parsing."
msgstr ""
