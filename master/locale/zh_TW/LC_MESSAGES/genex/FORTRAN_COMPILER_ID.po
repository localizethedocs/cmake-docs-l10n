#: ../../../genex/FORTRAN_COMPILER_ID.rst:12
msgid "$<Fortran_COMPILER_ID>"
msgstr ""

#: ../../../genex/FORTRAN_COMPILER_ID.rst:16
msgid "CMake's compiler id of the Fortran compiler used."
msgstr ""

#: ../../../genex/FORTRAN_COMPILER_ID.rst:21
msgid "$<Fortran_COMPILER_ID:compiler_ids>"
msgstr ""

#: ../../../genex/FORTRAN_COMPILER_ID.rst:25
msgid ""
"where ``compiler_ids`` is a comma-separated list. ``1`` if CMake's compiler "
"id of the Fortran compiler matches any one of the entries in "
"``compiler_ids``, otherwise ``0``."
msgstr ""

#: ../../../genex/FORTRAN_COMPILER_ID.rst:29
msgid ""
"Multiple ``compiler_ids`` can be specified. CMake 3.14 and earlier only "
"accepted a single compiler ID."
msgstr ""
