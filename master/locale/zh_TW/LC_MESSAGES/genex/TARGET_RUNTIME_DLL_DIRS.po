msgid "TARGET_RUNTIME_DLL_DIRS"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/TARGET_RUNTIME_DLL_DIRS.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/TARGET_RUNTIME_DLL_DIRS.rst:11
msgid "$<TARGET_RUNTIME_DLL_DIRS:tgt>"
msgstr ""

#: ../../../genex/TARGET_RUNTIME_DLL_DIRS.rst:17
msgid ""
"List of the directories which contain the DLLs that the target depends on at "
"runtime (see :genex:`TARGET_RUNTIME_DLLS`). This is determined by the "
"locations of all the ``SHARED`` targets in the target's transitive "
"dependencies. Using this generator expression on targets other than "
"executables, ``SHARED`` libraries, and ``MODULE`` libraries is an error. "
"**On non-DLL platforms, this expression always evaluates to an empty "
"string**."
msgstr ""

#: ../../../genex/TARGET_RUNTIME_DLL_DIRS.rst:24
msgid ""
"This generator expression can e.g. be used to create a batch file "
"using :command:`file(GENERATE)` which sets the PATH environment variable "
"accordingly."
msgstr ""
