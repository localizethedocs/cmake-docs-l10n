#: ../../../prop_rule/WORKING_DIRECTORY.rst:2
msgid "WORKING_DIRECTORY"
msgstr ""

#: ../../../prop_rule/WORKING_DIRECTORY.rst:6
msgid ""
"Execute the commands produced by the instantiation of the rule with the "
"given current working directory. If it is a relative path, it will be "
"interpreted relative to the build tree directory corresponding to the "
"current source directory of the target. If not specified, the default value "
"is the build directory corresponding to the current source directory of the "
"target."
msgstr ""

#: ../../../prop_rule/WORKING_DIRECTORY.rst:12
msgid ""
"Arguments to ``WORKING_DIRECTORY`` may use :manual:`generator expressions "
"<cmake-generator-expressions(7)>`."
msgstr ""
