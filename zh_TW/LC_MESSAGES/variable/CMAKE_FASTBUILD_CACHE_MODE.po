#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:2
msgid "CMAKE_FASTBUILD_CACHE_MODE"
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:6
msgid ""
"Specifies how builds started by :option:`cmake --build` use the FASTBuild "
"cache, with the values of FASTBuild's ``FASTBUILD_CACHE_MODE`` environment "
"variable:"
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:10
msgid "``r``"
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:11
msgid "Retrieve artifacts from the cache (FASTBuild's ``-cacheread``)."
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:13
msgid "``w``"
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:14
msgid "Store artifacts in the cache (``-cachewrite``)."
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:16
msgid "``rw``"
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:17
msgid "Both (``-cache``)."
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:19
msgid ""
"If not set, :option:`cmake --build` enables no caching itself, and FASTBuild "
"uses the cache only as its command line, for example ``cmake --build <dir> "
"-- -cache``, or its ``FASTBUILD_CACHE_MODE`` environment variable says."
msgstr ""

#: ../../../variable/CMAKE_FASTBUILD_CACHE_MODE.rst:24
msgid ""
":option:`cmake --build` reads this variable from the build tree's cache, so "
"set it as a cache entry, for example with :cmake-option:`-D` or in a "
"preset's :ref:`cacheVariables "
"<CMakePresets.configurePresets.cacheVariables>`. Builds from the generated "
"IDE projects use :variable:`CMAKE_FASTBUILD_IDE_ARGS` instead."
msgstr ""
