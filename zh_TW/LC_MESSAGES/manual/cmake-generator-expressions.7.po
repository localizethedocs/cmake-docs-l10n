"nonexistent on the file system (i.e. generated file) but must be known from "
"CMake. A source file becomes known from CMake if it is part of some target "
"(library or executable) or when a source file property is defined. Moreover, "
"this information is specific to the directory where the declaration occurred."
msgstr ""

#: ../../../manual/cmake-generator-expressions.7.rst:826
msgid ""
"For example, these generator expressions enable to offer a uniform behavior, "
"for the :command:`add_custom_command` and :command:`add_custom_target` "
"commands, regarding the source properties:"
msgstr ""

#: ../../../manual/cmake-generator-expressions.7.rst:830
msgid ""
"function(custom_add_library target)\n"
"  unset(sources)\n"
"  foreach(source IN LISTS ARGN)\n"
"    add_custom_command(\n"
"      OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/${source}.bin\n"
"      COMMAND my-compiler -o ${CMAKE_CURRENT_BINARY_DIR}/${source}.bin\n"
"                          \"$<$<SOURCE_EXISTS:${source}>:$<SOURCE_PROPERTY:$"
"{source},COMPILE_OPTIONS>>\"\n"
"                          ${source})\n"
"    list(APPEND sources ${CMAKE_CURRENT_BINARY_DIR}/${source}.bin)\n"
"  endforeach()\n"
"  add_custom_target(${target}\n"
"                    DEPENDS ${sources})\n"
"endfunction()\n"
"\n"
"custom_add_library(my-lib file1.x file2.x file3.x)\n"
"set_property(SOURCE file1.x PROPERTY COMPILE_OPTIONS -X)\n"
"set_property(SOURCE file2.x PROPERTY COMPILE_OPTIONS -Y)"
msgstr ""

