#: ../../../genex/STRING-SUBSTRING.rst:2
msgid "STRING:SUBSTRING"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-SUBSTRING.rst:10
msgid "Syntax"
msgstr "語法"

#: ../../../genex/STRING-SUBSTRING.rst:12
msgid "$<STRING:SUBSTRING,string,begin,length>"
msgstr ""

#: ../../../genex/STRING-SUBSTRING.rst:18
msgid ""
"The substring of the given ``string``. If ``length`` is ``-1`` or greater "
"than the ``string`` length the remainder of the string starting at ``begin`` "
"will be returned."
msgstr ""

#: ../../../genex/STRING-SUBSTRING.rst:22
msgid ""
"Both ``begin`` and ``length`` are counted in bytes, so care must be "
"exercised if ``string`` could contain multi-byte characters."
msgstr ""
