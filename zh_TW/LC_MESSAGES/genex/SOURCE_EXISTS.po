#: ../../../genex/SOURCE_EXISTS.rst:2
msgid "SOURCE_EXISTS"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:9
msgid "Syntax"
msgstr "語法"

#: ../../../genex/SOURCE_EXISTS.rst:11
msgid "$<SOURCE_EXISTS:src[,(DIRECTORY:dir|TARGET_DIRECTORY:tgt)]>"
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:17
msgid ""
"``1`` if ``src`` exists as a CMake source file, else ``0``. By default, the "
"source file is searched in the scope of the current source directory or the "
"directory of the consuming target."
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:21
msgid ""
"Directory scope can be overridden with one of the following sub-options:"
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:23
msgid "``DIRECTORY:dir``"
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:24
msgid ""
"The source file will be searched in the ``dir`` directory's scope. CMake "
"must know about the directory, either by having added  it through a call "
"to :command:`add_subdirectory` or ``dir`` being the top level directory. "
"Relative paths are treated as relative to the current source directory."
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:30
msgid "``TARGET_DIRECTORY:target``"
msgstr ""

#: ../../../genex/SOURCE_EXISTS.rst:31
msgid ""
"The source file will be searched in the directory scope in which ``target`` "
"was created (``target`` must therefore exist)."
msgstr ""
