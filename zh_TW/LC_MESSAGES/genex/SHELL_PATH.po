#: ../../../genex/SHELL_PATH.rst:2
msgid "SHELL_PATH"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/SHELL_PATH.rst:9
msgid "Syntax"
msgstr "語法"

#: ../../../genex/SHELL_PATH.rst:11
msgid "$<SHELL_PATH:...>"
msgstr ""

#: ../../../genex/SHELL_PATH.rst:17
msgid ""
"Content of ``...`` converted to shell path style. For example, slashes are "
"converted to backslashes in Windows shells and drive letters are converted "
"to posix paths in MSYS shells. The ``...`` must be an absolute path."
msgstr ""

#: ../../../genex/SHELL_PATH.rst:21
msgid ""
"The ``...`` may be a :ref:`semicolon-separated list <CMake Language Lists>` "
"of paths, in which case each path is converted individually and a result "
"list is generated using the shell path separator (``:`` on POSIX and ``;`` "
"on Windows).  Be sure to enclose the argument containing this genex in "
"double quotes in CMake source code so that ``;`` does not split arguments."
msgstr ""
