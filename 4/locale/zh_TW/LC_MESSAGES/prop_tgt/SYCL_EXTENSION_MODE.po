#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:2
msgid "SYCL_EXTENSION_MODE"
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:7
msgid "Experimental. Gated by ``CMAKE_EXPERIMENTAL_SYCL``."
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:9
msgid ""
"Controls whether C++ language flags and compile-feature requirements are "
"combined with their SYCL counterparts for SYCL compilation and linking."
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:12
msgid "Supported values are:"
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:14
msgid "``APPEND``"
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:15
msgid ""
"Use :variable:`CMAKE_CXX_FLAGS <CMAKE_<LANG>_FLAGS>` and its configuration-"
"specific value before :variable:`CMAKE_SYCL_FLAGS <CMAKE_<LANG>_FLAGS>` and "
"its configuration-specific value.  C++ and SYCL compile-feature and language-"
"standard requirements are combined.  This is the default when the property "
"is unset."
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:22
msgid "``REPLACE``"
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:23
msgid ""
"Use only SYCL language flags and SYCL compile-feature and language-standard "
"requirements."
msgstr ""

#: ../../../prop_tgt/SYCL_EXTENSION_MODE.rst:26
msgid ""
"This property does not change generator-expression language contexts.  For a "
"SYCL compilation, ``$<COMPILE_LANGUAGE:SYCL>`` is true and "
"``$<COMPILE_LANGUAGE:CXX>`` is false.  For a target linked with the SYCL "
"driver, ``$<LINK_LANGUAGE:SYCL>`` is true and ``$<LINK_LANGUAGE:CXX>`` is "
"false.  Properties and usage requirements are not evaluated a second time in "
"a C++ context."
msgstr ""
