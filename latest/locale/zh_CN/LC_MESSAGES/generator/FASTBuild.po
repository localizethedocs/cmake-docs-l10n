#: ../../../generator/FASTBuild.rst:2
msgid "FASTBuild"
msgstr ""

#: ../../../generator/FASTBuild.rst:6
msgid ""
"Generates a ``fbuild.bff`` file, which can be used to build the project with "
"`FASTBuild <https://www.fastbuild.org/docs/home.html>`_."
msgstr ""

#: ../../../generator/FASTBuild.rst:10
msgid "Usage"
msgstr ""

#: ../../../generator/FASTBuild.rst:12
msgid "Specify the generator when invoking :manual:`cmake(1)`:"
msgstr ""

#: ../../../generator/FASTBuild.rst:14
msgid "cmake [<options>] -G FASTBuild -B <path-to-build> [-S <path-to-source>]"
msgstr ""

#: ../../../generator/FASTBuild.rst:18
msgid ""
"This writes a FASTBuild configuration file named ``fbuild.bff`` into ``<path-"
"to-build>``."
msgstr ""

#: ../../../generator/FASTBuild.rst:23
msgid ""
"This generator also produces IDE project files for Visual Studio and Xcode, "
"which are placed under:"
msgstr ""

#: ../../../generator/FASTBuild.rst:26
msgid "``<path-to-build>/VisualStudio`` - Visual Studio solution and projects"
msgstr ""

#: ../../../generator/FASTBuild.rst:27
msgid "``<path-to-build>/XCode`` - Xcode workspace and projects"
msgstr ""

#: ../../../generator/FASTBuild.rst:29
msgid ""
"These IDE files can be generated by building ``xcode`` or ``solution`` "
"targets and will build using FASTBuild as the backend."
msgstr ""

#: ../../../generator/FASTBuild.rst:33
msgid "Built-in Targets"
msgstr ""

#: ../../../generator/FASTBuild.rst:35
msgid "``install_prep/<component>``"
msgstr ""

#: ../../../generator/FASTBuild.rst:39
msgid ""
"Created if the project has install rules, unless the :variable:"
"`CMAKE_SKIP_INSTALL_PREP_TARGETS` or :variable:`CMAKE_SKIP_INSTALL_RULES` "
"variable is enabled. Builds all known build dependencies for the named "
"install component. Components whose names cannot be represented safely are "
"excluded. See :ref:`Install Preparation Targets` and :ref:`Target Names`."
msgstr ""

#: ../../../generator/FASTBuild.rst:46
msgid "``install_prep/all``"
msgstr ""

#: ../../../generator/FASTBuild.rst:50
msgid ""
"Created if the project has install rules, unless the :variable:"
"`CMAKE_SKIP_INSTALL_PREP_TARGETS` or :variable:`CMAKE_SKIP_INSTALL_RULES` "
"variable is enabled. Builds all known build dependencies for an installation "
"that does not select a component. See :ref:`Install Preparation Targets`."
msgstr ""

#: ../../../generator/FASTBuild.rst:56
msgid "``test_prep/<test-name>``"
msgstr ""

#: ../../../generator/FASTBuild.rst:60
msgid ""
"Created unless the :variable:`CMAKE_SKIP_TEST_PREP_TARGETS` variable is "
"enabled. Builds all known build dependencies for the named test, including "
"the executable target invoked by the test, targets referenced by generator "
"expressions in the test command, and explicit ``BUILD_DEPENDS`` entries."
msgstr ""

#: ../../../generator/FASTBuild.rst:65
msgid ""
"Tests with names that are not valid target names are excluded. If multiple "
"tests in different directories share the same name, their dependencies are "
"merged into one ``test_prep/<test-name>`` target. See the :manual:`cmake-"
"buildsystem(7)` manual for more details on :ref:`Target Names`."
msgstr ""

#: ../../../generator/FASTBuild.rst:71
msgid ""
"Individual ``test_prep/<test-name>`` targets are not created for tests "
"discovered at test time, because their names are not known during generation."
msgstr ""

#: ../../../generator/FASTBuild.rst:75
msgid "``test_prep/all``"
msgstr ""

#: ../../../generator/FASTBuild.rst:79
msgid ""
"Created unless the :variable:`CMAKE_SKIP_TEST_PREP_TARGETS` variable is "
"enabled. Depends on every generated ``test_prep/<test-name>`` target. Also "
"builds dependencies recorded by the :prop_dir:`CMAKE_TEST_BUILD_DEPENDS` "
"directory property."
msgstr ""

#: ../../../generator/FASTBuild.rst:85
msgid "Caching"
msgstr ""

#: ../../../generator/FASTBuild.rst:87
msgid ""
"To enable FASTBuild caching, set the cache path using the :variable:"
"`CMAKE_FASTBUILD_CACHE_PATH` variable or the ``FASTBUILD_CACHE_PATH`` "
"environment variable."
msgstr ""

#: ../../../generator/FASTBuild.rst:91
msgid "Then build with the ``-cache`` flag:"
msgstr ""

#: ../../../generator/FASTBuild.rst:93
msgid "cmake --build <path-to-build> -- -cache"
msgstr ""

