#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:2
msgid "SYCL_SEPARABLE_COMPILATION"
msgstr ""

#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:7
msgid "Experimental. Gated by ``CMAKE_EXPERIMENTAL_SYCL``."
msgstr ""

#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:9
msgid "SYCL only: Enables separate compilation of device code"
msgstr ""

#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:11
msgid ""
"If set this will enable separable compilation for all SYCL files for the "
"given target."
msgstr ""

#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:14
msgid "For instance:"
msgstr ""

#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:16
msgid "set_property(TARGET myexe PROPERTY SYCL_SEPARABLE_COMPILATION ON)"
msgstr ""

#: ../../../prop_tgt/SYCL_SEPARABLE_COMPILATION.rst:20
msgid ""
"This property is initialized by the value of the :variable:"
"`CMAKE_SYCL_SEPARABLE_COMPILATION` variable if it is set when a target is "
"created."
msgstr ""
