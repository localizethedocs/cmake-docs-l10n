#: ../../../genex/STRING-TIMESTAMP.rst:2
msgid "STRING:TIMESTAMP"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:10
msgid "Syntax"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:12
msgid "$<STRING:TIMESTAMP[,(UTC|format)]...>"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:18
msgid "Produce a string representation of the current date and/or time."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:20
msgid ""
"If the generator expression is unable to obtain a timestamp, the result will "
"be the empty string ``\"\"``."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:23
msgid ""
"The optional ``UTC`` flag requests the current date/time representation to "
"be in Coordinated Universal Time (UTC) rather than local time."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:26
msgid ""
"If the ``SOURCE_DATE_EPOCH`` environment variable is set, its value will be "
"used instead of the current time. See https://reproducible-builds.org/specs/"
"source-date-epoch/ for details."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:30
msgid "The optional ``<format>`` may contain the following format specifiers:"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:32
msgid "``%%``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:33
msgid "A literal percent sign (%)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:35
msgid "``%d``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:36
msgid "The day of the current month (01-31)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:38
msgid "``%H``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:39
msgid "The hour on a 24-hour clock (00-23)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:41
msgid "``%I``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:42
msgid "The hour on a 12-hour clock (01-12)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:44
msgid "``%j``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:45
msgid "The day of the current year (001-366)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:47
msgid "``%m``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:48
msgid "The month of the current year (01-12)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:50
msgid "``%b``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:51
msgid "Abbreviated month name (e.g. Oct)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:53
msgid "``%B``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:54
msgid "Full month name (e.g. October)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:56
msgid "``%M``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:57
msgid "The minute of the current hour (00-59)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:59
msgid "``%s``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:60
msgid "Seconds since midnight (UTC) 1-Jan-1970 (UNIX time)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:62
msgid "``%S``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:63
msgid "The second of the current minute.  60 represents a leap second. (00-60)"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:65
msgid "``%f``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:66
msgid "The microsecond of the current second (000000-999999)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:68
msgid "``%U``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:69
msgid "The week number of the current year (00-53)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:71
msgid "``%V``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:72
msgid "The ISO 8601 week number of the current year (01-53)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:74
msgid "``%w``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:75
msgid "The day of the current week. 0 is Sunday. (0-6)"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:77
msgid "``%a``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:78
msgid "Abbreviated weekday name (e.g. Fri)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:80
msgid "``%A``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:81
msgid "Full weekday name (e.g. Friday)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:83
msgid "``%y``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:84
msgid "The last two digits of the current year (00-99)."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:86
msgid "``%Y``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:87
msgid "The current year."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:89
msgid "``%z``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:90
msgid ""
"The offset of the time zone from UTC, in hours and minutes, with format "
"``+hhmm`` or ``-hhmm``."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:93
msgid "``%Z``"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:94
msgid "The time zone name."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:96
msgid ""
"Unknown format specifiers will be ignored and copied to the output as-is."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:98
msgid "If no explicit ``format`` is given, it will default to:"
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:100
msgid "``%Y-%m-%dT%H:%M:%S`` for local time."
msgstr ""

#: ../../../genex/STRING-TIMESTAMP.rst:101
msgid "``%Y-%m-%dT%H:%M:%SZ`` for UTC."
msgstr ""
