#: ../../../genex/LIST-INSERT.rst:2
msgid "LIST:INSERT"
msgstr ""

#: ../../../manual/include/GENEX_FAMILY.rst:3
msgid ""
"This generator expression belongs to the |genex-family| family. See that "
"section for related generator expressions."
msgstr ""

#: ../../../genex/LIST-INSERT.rst:9
msgid "Syntax"
msgstr ""

#: ../../../genex/LIST-INSERT.rst:11
msgid "$<LIST:INSERT,list,index,item,...>"
msgstr ""

#: ../../../genex/LIST-INSERT.rst:17
msgid ""
"The ``list`` with the ``item`` (or multiple items) inserted at the specified "
"``index``.  Multiple items should be separated by commas."
msgstr ""

#: ../../../genex/LIST-INSERT.rst:20
msgid ""
"It is an error to specify an out-of-range ``index``. Valid indexes are 0 to "
"N, where N is the length of the list, inclusive. An empty list has length 0."
msgstr ""
