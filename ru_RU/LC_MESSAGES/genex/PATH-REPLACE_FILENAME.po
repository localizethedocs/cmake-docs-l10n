msgstr ""

#: ../../../genex/PATH-REPLACE_FILENAME.rst:11
msgid "$<PATH:REPLACE_FILENAME,path...,input>"
msgstr ""

#: ../../../genex/PATH-REPLACE_FILENAME.rst:17
msgid ""
"Returns ``path`` with the filename component replaced by ``input``. If "
"``path`` has no filename component (i.e. ``$<PATH:HAS_FILENAME>`` returns "
"``0``), ``path`` is unchanged."
